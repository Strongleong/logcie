:test strict_c99_reports_whatever_clock_it_has
:command compile
:blob executable 2
cc
:blob args 81
-std=c99 -pedantic -Wall -Wextra -Werror -I../.. subsecond.c -o .side_effects/c99
:int return 0
:command run
:blob executable 17
.side_effects/c99
:int return 0
:blob stdout 61
nanos_in_range=1
time_always_set=1
matches_available_clock=1

:test c11_reports_whatever_clock_it_has
:command compile
:blob executable 2
cc
:blob args 71
-std=c11 -Wall -Wextra -Werror -I../.. subsecond.c -o .side_effects/c11
:int return 0
:command run
:blob executable 17
.side_effects/c11
:int return 0
:blob stdout 61
nanos_in_range=1
time_always_set=1
matches_available_clock=1

:test posix_opt_in_reports_whatever_clock_it_has
:command compile
:blob executable 2
cc
:blob args 99
-std=c99 -D_POSIX_C_SOURCE=200809L -Wall -Wextra -Werror -I../.. subsecond.c -o .side_effects/posix
:int return 0
:command run
:blob executable 19
.side_effects/posix
:int return 0
:blob stdout 61
nanos_in_range=1
time_always_set=1
matches_available_clock=1

